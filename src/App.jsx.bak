const G = () => (
  <style>{`
    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,600&family=IBM+Plex+Mono:wght@400;500&family=Bebas+Neue&display=swap');
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
    :root{
      --ink:#0f0f0f; --ink2:#3a3a3a; --ink3:#6b6b6b; --ink4:#9a9a9a;
      --rule:#e8e8e8; --bg:#fafafa; --white:#fff; --black:#0a0a0a;
      --accent:#1a472a; --accent-light:#e8f5e9;
      --warn:#c0392b; --yellow:#d4800a; --blue:#1a56db;
      --sans:'IBM Plex Sans',sans-serif; --mono:'IBM Plex Mono',monospace;
      --display:'Bebas Neue',sans-serif;
      --r:6px;
      --pad-x:12px;
      --pad-x-tight:10px;
    }
    @media (min-width: 480px){
      :root{ --pad-x:16px; --pad-x-tight:14px; }
    }
    html,body{background:var(--bg);font-family:var(--sans);color:var(--ink);
      -webkit-text-size-adjust:100%;text-size-adjust:100%;}
    input,select,textarea,button{font-family:var(--sans);}
    @keyframes spin{from{transform:rotate(0)}to{transform:rotate(360deg)}}
    .card{background:var(--white);border:1px solid var(--rule);border-radius:var(--r);}
    .card-l{border-left:3px solid var(--accent);}
    .btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;
      font-family:var(--sans);font-weight:600;font-size:13px;border:none;
      border-radius:var(--r);cursor:pointer;transition:all .15s;padding:10px 18px;}
    .btn:hover:not(:disabled){filter:brightness(.92);}
    .btn:disabled{cursor:not-allowed;opacity:.45;}
    .btn-p{background:var(--accent);color:#fff;}
    .btn-o{background:transparent;border:1.5px solid var(--ink);color:var(--ink);}
    .btn-o:hover:not(:disabled){background:var(--ink);color:#fff;}
    .btn-g{background:transparent;color:var(--ink3);border:1px solid var(--rule);}
    .btn-g:hover:not(:disabled){background:var(--bg);color:var(--ink);}
    .btn-sm{padding:6px 12px;font-size:12px;}
    .btn-pill{border-radius:20px;padding:6px 14px;font-size:12px;font-weight:600;
      border:1.5px solid var(--rule);background:#fff;color:var(--ink3);cursor:pointer;transition:all .15s;}
    .btn-pill.on{background:var(--accent);color:#fff;border-color:var(--accent);}
    .inp{width:100%;padding:10px 12px;border:1.5px solid var(--rule);border-radius:var(--r);
      font-size:14px;color:var(--ink);background:#fff;outline:none;transition:border-color .15s;}
    .inp:focus{border-color:var(--accent);}
    .inp::placeholder{color:var(--ink4);}
    .sel{width:100%;padding:10px 12px;border:1.5px solid var(--rule);border-radius:var(--r);
      font-size:14px;color:var(--ink);background:#fff;outline:none;appearance:none;cursor:pointer;}
    .sel:focus{border-color:var(--accent);}
    label.lbl{display:block;font-size:11px;font-weight:600;color:var(--ink3);
      letter-spacing:.8px;text-transform:uppercase;margin-bottom:5px;}
    .tag{display:inline-flex;align-items:center;font-size:11px;font-weight:600;
      padding:3px 8px;border-radius:20px;}
    .tag-a{background:#fce8e8;color:var(--warn);}
    .tag-b{background:#e8f0fe;color:var(--blue);}
    .tag-c{background:#fef9e7;color:var(--yellow);}
    .tag-d{background:#f0f0f0;color:var(--ink3);}
    .nav-tab{background:none;border:none;border-bottom:2px solid transparent;
      font-family:var(--sans);font-size:13px;font-weight:500;color:var(--ink3);
      padding:12px 0;cursor:pointer;transition:all .15s;}
    .nav-tab.active{color:var(--ink);border-bottom-color:var(--ink);}
    .garmin-box{background:#f8f8f8;border:1px solid var(--rule);border-radius:var(--r);
      padding:12px 14px;font-family:var(--mono);font-size:12px;color:var(--ink2);
      line-height:1.7;white-space:pre-wrap;word-break:break-word;}
    .rule{border:none;border-top:1px solid var(--rule);margin:16px 0;}
    .spin{display:inline-block;width:14px;height:14px;border:2px solid rgba(255,255,255,.3);
      border-top-color:#fff;border-radius:50%;animation:spin .6s linear infinite;}
    .copied{color:var(--accent)!important;}
    select option{background:#fff;}
  `}</style>
);

